<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexora - Startup Company</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar">
            <h2 class="logo">NEXORA<span>.</span></h2>

            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#team">Team</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section class="home" id="home">
        <div class="home-content">
            <h1>Building Ideas Into <span>Reality</span></h1>
            <p>
                We are a creative startup company helping businesses
                grow through innovative technology and smart solutions.
            </p>
            <a href="#about" class="btn">Explore More</a>
        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
        <h2>About Our Company</h2>
        <p>
            Nexora is an innovative startup focused on creating
            modern digital solutions. Our mission is to transform
            ideas into powerful products and services.
        </p>
    </section>

    <!-- Services Section -->
    <section class="services" id="services">
        <h2>Our Products & Services</h2>

        <div class="service-container">

            <div class="service-card">
                <h3>Web Development</h3>
                <p>We build modern and responsive websites for businesses.</p>
            </div>

            <div class="service-card">
                <h3>AI Solutions</h3>
                <p>Smart AI-powered solutions to improve productivity.</p>
            </div>

            <div class="service-card">
                <h3>Digital Marketing</h3>
                <p>Helping brands reach more customers online.</p>
            </div>

        </div>
    </section>

    <!-- Achievements Section -->
    <section class="achievements">
        <h2>Our Achievements</h2>

        <div class="achievement-container">
            <div>
                <h3>50+</h3>
                <p>Projects Completed</p>
            </div>

            <div>
                <h3>30+</h3>
                <p>Happy Clients</p>
            </div>

            <div>
                <h3>10+</h3>
                <p>Team Members</p>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team" id="team">
        <h2>Meet Our Team</h2>

        <div class="team-container">

            <div class="team-card">
                <img src="https://i.pravatar.cc/150?img=12" alt="Founder">
                <h3>Arjun Kumar</h3>
                <p>Founder & CEO</p>
            </div>

            <div class="team-card">
                <img src="https://i.pravatar.cc/150?img=47" alt="Developer">
                <h3>Priya Sharma</h3>
                <p>Lead Developer</p>
            </div>

            <div class="team-card">
                <img src="https://i.pravatar.cc/150?img=11" alt="Designer">
                <h3>Rahul Verma</h3>
                <p>UI/UX Designer</p>
            </div>

        </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials">
        <h2>What People Say</h2>

        <div class="testimonial-card">
            <p>
                "Nexora provided excellent digital solutions.
                Their team is creative, professional and reliable."
            </p>
            <h3>- Happy Customer</h3>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>
        <p>Have an idea? Let's build something amazing together!</p>

        <form>
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea placeholder="Your Message" required></textarea>
            <button type="submit">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <h3>NEXORA.</h3>
        <p>Innovating Today, Transforming Tomorrow.</p>
        <p>© 2026 Nexora. All Rights Reserved.</p>
    </footer>

</body>
</html>
