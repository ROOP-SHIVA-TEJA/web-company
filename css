* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #f5f7ff;
    color: #222;
}

/* Navigation */
header {
    background: #101b3f;
    padding: 20px 8%;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
    font-size: 28px;
}

.logo span {
    color: #00d4ff;
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

.navbar ul li a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

.navbar ul li a:hover {
    color: #00d4ff;
}

/* Home */
.home {
    min-height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #101b3f, #3458a4);
    color: white;
}

.home-content h1 {
    font-size: 45px;
    margin-bottom: 20px;
}

.home-content h1 span {
    color: #00d4ff;
}

.home-content p {
    max-width: 600px;
    line-height: 1.7;
    margin: 0 auto 30px;
}

.btn {
    display: inline-block;
    background: #00d4ff;
    color: #101b3f;
    padding: 13px 28px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

/* Common Section */
section h2 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 30px;
}

/* About */
.about {
    padding: 70px 10%;
    text-align: center;
}

.about p {
    max-width: 750px;
    margin: auto;
    line-height: 1.8;
    color: #555;
}

/* Services */
.services {
    padding: 70px 8%;
    background: white;
}

.service-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.service-card {
    background: #f0f4ff;
    padding: 30px;
    width: 280px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 4px 12px #00000015;
}

.service-card h3 {
    color: #3458a4;
    margin-bottom: 15px;
}

.service-card p {
    line-height: 1.6;
}

/* Achievements */
.achievements {
    padding: 65px 8%;
    background: #101b3f;
    color: white;
    text-align: center;
}

.achievement-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 30px;
}

.achievement-container h3 {
    font-size: 35px;
    color: #00d4ff;
    margin-bottom: 10px;
}

/* Team */
.team {
    padding: 70px 8%;
}

.team-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.team-card {
    background: white;
    padding: 25px;
    width: 250px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 4px 12px #00000015;
}

.team-card img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    margin-bottom: 15px;
}

.team-card h3 {
    margin-bottom: 8px;
}

.team-card p {
    color: #666;
}

/* Testimonials */
.testimonials {
    background: #eaf0ff;
    padding: 70px 10%;
    text-align: center;
}

.testimonial-card {
    max-width: 600px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 10px;
    line-height: 1.8;
}

/* Contact */
.contact {
    padding: 70px 20px;
    text-align: center;
    background: white;
}

.contact form {
    max-width: 500px;
    margin: 30px auto 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact input,
.contact textarea {
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 15px;
}

.contact textarea {
    height: 120px;
    resize: vertical;
}

.contact button {
    padding: 14px;
    background: #101b3f;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

.contact button:hover {
    background: #3458a4;
}

/* Footer */
footer {
    background: #101b3f;
    color: white;
    text-align: center;
    padding: 25px;
    line-height: 1.8;
}

/* Responsive Design */
@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .navbar ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .home-content h1 {
        font-size: 32px;
    }

    .service-container,
    .team-container {
        flex-direction: column;
        align-items: center;
    }

    .achievement-container {
        flex-direction: column;
    }
}
